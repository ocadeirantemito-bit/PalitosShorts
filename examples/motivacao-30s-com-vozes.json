    "title": "Recomeço sem plateia",
    "category": "Motivação",
    "duration": 30,
    "background": "creme",
    "scenes": [
      {
        "speaker": "PALITO",
        "line": "Ninguém viu eu recomeçar.",
        "caption": "",
        "action": "apontar"
      },
      {
        "speaker": "TICO",
        "line": "A semente também cresce debaixo da terra.",
        "caption": "",
        "action": "surpresa"
      },
      {
        "speaker": "PALITO",
        "line": "Eu estava esperando a coragem aparecer. Agora vejo que ela cresce quando eu começo.",
        "caption": "",
        "action": "apontar"
      },
      {
        "speaker": "TICO",
        "line": "Guarde essa pequena vitória. Quando a dúvida voltar, lembre que você já conseguiu dar o primeiro passo.",
        "caption": "",
        "action": "acenar"
      },
      {
        "speaker": "PALITO",
        "line": "Vou cuidar do meu próximo passo.",
        "caption": "Um passo de cada vez.",
        "action": "apontar"
      }
    ],
    "created": "2026-11-03T12:37:59.047Z",
